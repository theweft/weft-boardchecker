// Overlay that matches the demo board.
/dts-v1/;
/plugin/;

/ {
	compatible = "brcm,bcm2711";

	fragment@0 {
		target = <&i2c1>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			adc@48 {
				compatible = "ti,ads1115";
				reg = <0x48>;
				interrupt-parent = <&gpio>;
				interrupts = <23 2>;
			};

			dac@60 {
				compatible = "microchip,mcp4728";
				reg = <0x60>;
			};
		};
	};

	fragment@1 {
		target = <&spi0>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			sensor@1 {
				compatible = "acme,testspi";
				reg = <1>;
				reset-gpios = <&gpio 22 1>;
				spi-max-frequency = <1000000>;
			};
		};
	};

	fragment@2 {
		target = <&spidev1>;
		__overlay__ {
			status = "disabled";
		};
	};
};
